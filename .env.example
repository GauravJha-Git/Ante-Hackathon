# From https://app.tavily.com — hackathon coupon GEEKROOM2 if you still need credits.
TAVILY_API_KEY=

# Bifrost OpenAI-compatible base, including /v1.
# Local gateway: http://localhost:8080/openai/v1
BIFROST_BASE_URL=http://localhost:8080/openai/v1

# Bifrost virtual key (sk-bf-...). Sent as Authorization: Bearer.
BIFROST_API_KEY=

# Must match a model configured in your Bifrost instance.
BIFROST_MODEL=gpt-4o-mini

# basic = 1 Tavily credit per search. advanced = 2. A briefing runs 4 searches.
# Use basic while testing. Use advanced for the demo.
TAVILY_SEARCH_DEPTH=basic

PORT=3000
